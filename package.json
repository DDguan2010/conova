{
  "name": "conova",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Conova",
  "author": "Conova",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win:dir": "npm run build && electron-builder --win --dir --x64",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@vitejs/plugin-react": "latest",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "com.conova.music",
    "productName": "Conova",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "server/**/*", "build/icon.png", "package.json"],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "signExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.5.1"
  }
}
